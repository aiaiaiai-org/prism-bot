#!/usr/bin/env ruby
# © 2026 aiaiaiai · aiaiaiai.org

require "digest"
require "rbconfig"
require "yaml"

root = File.expand_path("..", __dir__)
contract_path = File.join(root, "contracts/prism-hub.v1.openapi.yaml")
source_path = File.join(root, "contracts/prism-hub.v1.source.yaml")
contract_source = File.read(contract_path)
contract = YAML.safe_load(contract_source, aliases: false)
source = YAML.safe_load_file(source_path, aliases: false).fetch("source")

actual_digest = Digest::SHA256.hexdigest(contract_source)
raise "pinned Hub contract digest drift" unless source.fetch("sha256") == actual_digest
raise "OpenAPI version drift" unless contract.fetch("openapi") == "3.1.0"
raise "Hub client-readiness contract drift" unless contract.dig("info", "version") == "0.1.0-alpha.7"

expected_operations = {
  ["/api/v1/actors/resolve", "post"] => "resolveActor",
  ["/api/v1/actors/onboard", "post"] => "onboardActor",
  ["/api/v1/actors/personal/resolve", "post"] => "resolvePersonalActor",
  ["/api/v1/channels", "get"] => "listChannels",
  ["/api/v1/publications/validate", "post"] => "validatePublication",
  ["/api/v1/publications", "post"] => "publishPublication"
}
expected_operations.each do |(route, method), operation_id|
  actual = contract.dig("paths", route, method, "operationId")
  raise "missing #{method.upcase} #{route} operation" unless actual == operation_id

  responses = contract.dig("paths", route, method, "responses")
  %w[401 403].each do |status|
    raise "#{method.upcase} #{route} must declare #{status}" unless responses.key?(status)
  end
end

actor_request = contract.dig("components", "schemas", "ActorResolutionRequest")
unless actor_request.fetch("required").sort == %w[provider provider_scope subject_id workspace_id]
  raise "ActorResolutionRequest fields drift"
end
unless actor_request.dig("properties", "subject_id", "type") == "string"
  raise "actor subject_id must remain opaque string data"
end

onboarding_request = contract.dig("components", "schemas", "ActorOnboardingRequest")
unless onboarding_request.fetch("required").sort == %w[provider provider_scope subject_id]
  raise "ActorOnboardingRequest fields drift"
end
unless onboarding_request.dig("properties", "subject_id", "type") == "string"
  raise "onboarding subject_id must remain opaque string data"
end

actor_response_properties = contract.dig(
  "components", "schemas", "ActorResolutionResponse", "properties"
).keys.sort
raise "actor response must expose only actor" unless actor_response_properties == ["actor"]

resolved_actor_properties = contract.dig(
  "components", "schemas", "ResolvedActor", "properties"
).keys.sort
unless resolved_actor_properties == %w[identity role]
  raise "resolved actor must expose only canonical identity and workspace role"
end

onboarding_response_properties = contract.dig(
  "components", "schemas", "ActorOnboardingResponse", "properties"
).keys.sort
raise "personal actor response must expose only actor" unless onboarding_response_properties == ["actor"]

onboarded_actor_properties = contract.dig(
  "components", "schemas", "OnboardedActor", "properties"
).keys.sort
unless onboarded_actor_properties == %w[identity role workspace_id]
  raise "personal actor must expose only canonical identity, workspace, and role"
end

identity_properties = contract.dig(
  "components", "schemas", "CanonicalIdentity", "properties"
).keys.sort
unless identity_properties == %w[id type]
  raise "canonical actor identity disclosure drift"
end

%w[/api/v1/actors/onboard /api/v1/actors/personal/resolve].each do |route|
  schema_ref = contract.dig(
    "paths", route, "post", "requestBody", "content", "application/json", "schema", "$ref"
  )
  unless schema_ref == "#/components/schemas/ActorOnboardingRequest"
    raise "#{route} must use ActorOnboardingRequest"
  end

  response_ref = contract.dig(
    "paths", route, "post", "responses", "200", "content", "application/json", "schema", "$ref"
  )
  unless response_ref == "#/components/schemas/ActorOnboardingResponse"
    raise "#{route} must use ActorOnboardingResponse"
  end
end

target_properties = contract.dig(
  "components",
  "schemas",
  "PublicationTarget",
  "properties"
).keys.sort
unless target_properties == %w[channel_id id selection]
  raise "PublicationTarget must expose only public Hub targeting fields"
end

formats = contract.dig(
  "components",
  "schemas",
  "ContentVariant",
  "properties",
  "format",
  "enum"
)
raise "post and story formats must remain explicit" unless %w[post story].all? { formats.include?(_1) }

channel_required = contract.dig("components", "schemas", "Channel", "required")
raise "Hub channels must declare capabilities" unless channel_required.include?("capabilities")

channel_parameters = contract.dig("paths", "/api/v1/channels", "get", "parameters")
parameter_refs = channel_parameters.map { |parameter| parameter.fetch("$ref") }
unless %w[#/components/parameters/PageCursor #/components/parameters/PageLimit].all? { |ref| parameter_refs.include?(ref) }
  raise "generated client contract must expose channel cursor pagination"
end

error_required = contract.dig("components", "schemas", "ErrorResponse", "required")
raise "Hub errors must carry request_id" unless error_required.include?("request_id")

generator = File.join(root, "script/generate_hub_client")
abort "generated Hub client is stale" unless system(RbConfig.ruby, generator, "--check")

puts "pinned Hub contract and generated client are valid"
