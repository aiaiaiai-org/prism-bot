#!/usr/bin/env ruby
# © 2026 aiaiaiai · aiaiaiai.org

require "digest"
require "fileutils"
require "yaml"

root = File.expand_path("..", __dir__)
contract_path = File.join(root, "contracts/prism-hub.v1.openapi.yaml")
output_path = File.join(root, "lib/prism_bot/generated/prism_hub_v1_client.rb")
contract_source = File.read(contract_path)
contract = YAML.safe_load(contract_source, aliases: false)

operations = contract.fetch("paths").each_with_object({}) do |(path, methods), values|
  methods.each_value do |operation|
    next unless operation.is_a?(Hash) && operation["operationId"]

    values[operation.fetch("operationId")] = path
  end
end

required = %w[listChannels publishPublication resolveActor validatePublication]
missing = required - operations.keys
abort "missing Hub operations: #{missing.join(', ')}" if missing.any?

template = <<~'RUBY'
  # © 2026 aiaiaiai · aiaiaiai.org
  # Generated by script/generate_hub_client. Do not edit by hand.

  module PrismBot
    module Generated
      class PrismHubV1Client
        CONTRACT_SHA256 = "%<digest>s"
        LIST_CHANNELS_PATH = %<list_path>s
        PUBLISH_PUBLICATION_PATH = %<publish_path>s
        RESOLVE_ACTOR_PATH = %<resolve_actor_path>s
        VALIDATE_PUBLICATION_PATH = %<validate_path>s

        def initialize(base_url:, token:, transport:)
          unless token.is_a?(String) && token.length >= 32
            raise ConfigurationError.new(
              "bot.hub.token.invalid",
              "PRISM_HUB_API_TOKEN must contain at least 32 characters"
            )
          end

          @base_url = String(base_url).sub(%%r{/+\z}, "").freeze
          @token = token.dup.freeze
          @transport = transport
        end

        def list_channels(limit: 100, cursor: nil)
          parameters = {"limit" => limit}
          parameters["cursor"] = cursor if cursor
          request("GET", "#{LIST_CHANNELS_PATH}?#{URI.encode_www_form(parameters)}")
        end

        def resolve_actor(provider:, provider_scope:, subject_id:)
          request(
            "POST",
            RESOLVE_ACTOR_PATH,
            payload: {
              "provider" => provider,
              "provider_scope" => provider_scope,
              "subject_id" => subject_id
            }
          )
        end

        def publish_publication(payload:, idempotency_key:)
          request(
            "POST",
            PUBLISH_PUBLICATION_PATH,
            payload: payload,
            idempotency_key: idempotency_key
          )
        end

        def validate_publication(payload:, idempotency_key:)
          request(
            "POST",
            VALIDATE_PUBLICATION_PATH,
            payload: payload,
            idempotency_key: idempotency_key
          )
        end

        private

        def request(method, path, payload: nil, idempotency_key: nil)
          headers = {
            "accept" => "application/json",
            "authorization" => "Bearer #{@token}"
          }
          body = nil
          if payload
            headers["content-type"] = "application/json"
            headers["idempotency-key"] = String(idempotency_key) if idempotency_key
            body = JSON.generate(payload)
          end

          response = @transport.call(
            method: method,
            url: "#{@base_url}#{path}",
            headers: headers,
            body: body
          )
          parsed = parse_response(response.body)
          return parsed if response.status.between?(200, 299)

          error = parsed.fetch("error", {})
          raise HubError.new(
            error.fetch("code", "bot.hub.request_failed"),
            error.fetch("message", "Prism Hub rejected the request"),
            http_status: response.status,
            request_id: parsed["request_id"] || response.headers&.fetch("x-request-id", nil)
          )
        end

        def parse_response(source)
          value = JSON.parse(source)
          return value if value.is_a?(Hash)

          raise JSON::ParserError
        rescue JSON::ParserError
          raise TransportError.new(
            "bot.hub.response.invalid",
            "Prism Hub returned an invalid JSON response"
          )
        end
      end
    end
  end
RUBY

generated = format(
  template,
  digest: Digest::SHA256.hexdigest(contract_source),
  list_path: operations.fetch("listChannels").inspect,
  publish_path: operations.fetch("publishPublication").inspect,
  resolve_actor_path: operations.fetch("resolveActor").inspect,
  validate_path: operations.fetch("validatePublication").inspect
)

if ARGV == ["--check"]
  abort "generated Hub client is stale" unless File.exist?(output_path) && File.read(output_path) == generated

  puts "generated Hub client matches its pinned contract"
else
  FileUtils.mkdir_p(File.dirname(output_path))
  File.write(output_path, generated)
  puts output_path
end
